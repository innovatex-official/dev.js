{
  "name": "hello-devjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../packages/cli/dist/index.js build",
    "dev": "node ../../packages/cli/dist/index.js dev",
    "doctor": "node ../../packages/cli/dist/index.js doctor",
    "doctor:json": "node ../../packages/cli/dist/index.js doctor --json",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devjs/build": "workspace:*",
    "@devjs/cli": "workspace:*",
    "@devjs/config": "workspace:*",
    "@devjs/core": "workspace:*",
    "@devjs/plugin": "workspace:*",
    "@devjs/project": "workspace:*",
    "@devjs/router": "workspace:*",
    "@devjs/runtime": "workspace:*",
    "@devjs/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
