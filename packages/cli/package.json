{
  "name": "@devjs/cli",
  "version": "0.0.0",
  "description": "Command-line interface for dev.js.",
  "type": "module",
  "bin": {
    "devjs": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist *.tsbuildinfo",
    "dev": "tsup --watch",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "bench": "tsx bench/cli.bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devjs/build": "workspace:*",
    "@devjs/core": "workspace:*",
    "@devjs/project": "workspace:*",
    "@devjs/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "rimraf": "latest",
    "tinybench": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
