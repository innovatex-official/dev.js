{
  "name": "@devjs/config",
  "version": "0.1.0",
  "description": "Configuration schema and helpers for dev.js projects.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rimraf dist *.tsbuildinfo",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "bench": "tsx bench/config.bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devjs/plugin": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "latest",
    "tinybench": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/innovatex-official/dev.js.git",
    "directory": "packages/config"
  }
}
