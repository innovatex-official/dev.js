{
  "name": "@devjs/deploy",
  "version": "0.1.0",
  "description": "Deployment adapters for dev.js applications.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/innovatex-official/dev.js.git",
    "directory": "packages/deploy"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc --emitDeclarationOnly",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "latest",
    "rimraf": "latest",
    "tsup": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
