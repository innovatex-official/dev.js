{
  "name": "@devjs/plugin",
  "version": "0.0.0",
  "description": "Plugin contract for dev.js platform extensions.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rimraf dist *.tsbuildinfo",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "bench": "tsx bench/plugin.bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "rimraf": "latest",
    "tinybench": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
